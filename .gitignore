# Data — never commit the raw dataset or the DB (too large, and reproducible via download)
data/raw/
*.csv
*.csv.gz
*.db
*.sqlite
*.sqlite3
*.parquet

# ...but DO keep the small generated reports (data dictionary + triage decisions)
!reports/*.csv

# Trained model binaries — large, reproducible from code
models/
*.joblib

# Kaggle credentials — must never be committed
kaggle.json
.kaggle/

# Python
venv/
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/

# Reports scratch
reports/*.tmp

# OS
.DS_Store
